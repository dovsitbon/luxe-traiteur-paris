{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/mariages", "destination": "/fr/mariages/", "permanent": true },
    { "source": "/devis", "destination": "/fr/devis/", "permanent": true },
    { "source": "/location-de-salles", "destination": "/fr/location-de-salles/", "permanent": true },
    { "source": "/mentions-legales", "destination": "/fr/mentions-legales/", "permanent": true }
  ],
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
